    <PostBuildEvent>
      <Message>Package plugins+mods zip (optional deploy)</Message>
      <Command>set "PKG_DIR=$(OutDir)package"
set "PKG_ZIP=$(OutDir)ThirdSpace_Titanfall2.zip"
if exist "%PKG_DIR%" rmdir /s /q "%PKG_DIR%"
if exist "%PKG_ZIP%" del /q "%PKG_ZIP%"
xcopy /Y /Q "$(TargetPath)" "%PKG_DIR%\plugins\" &gt;nul || (echo ERROR: packaging failed &amp; exit /b 1)
xcopy /Y /Q /E /I "$(ProjectDir)mod\ThirdSpace_Titanfall2" "%PKG_DIR%\mods\ThirdSpace_Titanfall2\" &gt;nul || (echo ERROR: packaging failed &amp; exit /b 1)
tar -a -c -f "%PKG_ZIP%" -C "%PKG_DIR%" plugins mods || (echo ERROR: could not create zip &amp; exit /b 1)
echo Packaged "%PKG_ZIP%"
if /I not "$(DeployToGame)"=="true" exit /b 0
if "$(Tf2GameDir)"=="" (echo ERROR: set Tf2GameDir &amp; exit /b 1)
set "PROFILE_DIR=$(Tf2GameDir)\$(Tf2Profile)"
xcopy /Y /Q "$(TargetPath)" "%PROFILE_DIR%\plugins\"
xcopy /Y /Q /E /I "$(ProjectDir)mod\ThirdSpace_Titanfall2" "%PROFILE_DIR%\mods\ThirdSpace_Titanfall2\"
echo Deployed to %PROFILE_DIR%</Command>
    </PostBuildEvent>
